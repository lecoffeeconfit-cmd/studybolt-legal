const sections=document.querySelectorAll('.section[id]');const links=document.querySelectorAll('.toc a');
if('IntersectionObserver' in window){const currentObserver=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){links.forEach(a=>{const active=a.getAttribute('href')==='#'+e.target.id;a.classList.toggle('active',active);if(active)a.setAttribute('aria-current','location');else a.removeAttribute('aria-current')})}})},{rootMargin:'-15% 0px -70% 0px'});sections.forEach(s=>currentObserver.observe(s))}
let ticking=false;function updateProgress(){const h=document.documentElement;const scrollable=h.scrollHeight-h.clientHeight;document.getElementById('progress').style.width=(scrollable>0?Math.max(0,Math.min(100,(h.scrollTop/scrollable)*100)):100)+'%';ticking=false}window.addEventListener('scroll',()=>{if(!ticking){requestAnimationFrame(updateProgress);ticking=true}},{passive:true});updateProgress();
</script>
</body>
</html>
